# Environment for the Pages CMS container. Copy to .env for docker compose.
# Full reference: https://pagescms.org/docs/development/environment-variables/

# --- Required -------------------------------------------------------------
# Canonical public URL of the app (used for auth callbacks and links).
BASE_URL=http://localhost:3000
# PostgreSQL connection string (compose.yaml overrides this to point at its db).
DATABASE_URL=postgresql://pagescms:pagescms@localhost:5432/pagescms
# Generate each with: openssl rand -base64 32
BETTER_AUTH_SECRET=
CRYPTO_KEY=

# GitHub App (see https://pagescms.org/docs/guides/installing/github-app/)
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
# PEM private key. Docker Compose accepts a double-quoted multi-line value:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# ...
# -----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=

# --- Optional -------------------------------------------------------------
# ADMIN_EMAILS=admin@example.com,other-admin@example.com

# Email (needed for collaborator invites / email sign-in)
# EMAIL_PROVIDER=resend          # or smtp
# EMAIL_FROM=Pages CMS <no-reply@example.com>
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Postgres connection pool size per container (upstream default: 5)
# POSTGRES_MAX_CONNECTIONS=5

# --- Container-specific -----------------------------------------------------
# Run DB migrations before starting the server (default true).
# MIGRATE_ON_START=true
# Listen port / address (defaults 3000 / 0.0.0.0)
# PORT=3000
# BIND_HOST=0.0.0.0
